(version 1)

# ---------------------------------------------------------------------------
# KEY_RIGHT_MECH_KEEP_OUT - right hand switch column (review item 1)
#
# X = 49..51 mm, Y = 0..84 mm is a full height blocking wall: the whole right
# strip belongs to the enclosure (keys, locating holes, copper, tracks, vias)
# and no ordinary component may enter it from any side.  A KiCad zone keepout
# cannot exempt an individual footprint, so the wall is a rule area and the
# permitted occupants are listed here explicitly: SW3/SW4/SW5 and the four
# locating holes H1..H4 (the two lower holes sit at X = 52 and their courtyards
# reach into the wall).
# ---------------------------------------------------------------------------
(rule "KEY_RIGHT_MECH_KEEP_OUT: keys and locating holes only"
	(constraint disallow footprint)
	(condition "A.insideArea('KEY_RIGHT_MECH_KEEP_OUT') && !(A.Reference == 'SW3') && !(A.Reference == 'SW4') && !(A.Reference == 'SW5') && !(A.Reference == 'H1') && !(A.Reference == 'H2') && !(A.Reference == 'H3') && !(A.Reference == 'H4')")
)

# ---------------------------------------------------------------------------
# Neck areas - published by tools/route.py + tools/apply_routing.py.
#
# The IC pad fields are 0.4-0.5 mm pitch.  A wide track cannot
# physically leave those pads, so the router draws the net class
# width wherever the geometry allows and necks down only where it
# must, inside the areas below.  Each area is generated from the
# necked segments themselves (bounding box + 0.4 mm), so a rule can
# never cover more copper than the real neck.
# ---------------------------------------------------------------------------
(rule "Neck PWR_NECK_1 HV_EPD"
	(constraint track_width (min 0.19))
	(condition "A.NetClass == 'HV_EPD' && A.insideArea('PWR_NECK_1')")
)
(rule "Neck PWR_NECK_2 HV_EPD"
	(constraint track_width (min 0.15))
	(condition "A.NetClass == 'HV_EPD' && A.insideArea('PWR_NECK_2')")
)
(rule "Neck PWR_NECK_3 POWER"
	(constraint track_width (min 0.24))
	(condition "A.NetClass == 'POWER' && A.insideArea('PWR_NECK_3')")
)

